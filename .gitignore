# Processed data policy:
# Ignore large tables > 8MB by default to prevent accidental staging
data/processed/track2/00_phase0_consolidated_candidates.csv
data/processed/track2/01_phase1_variant_mechanism_matrix.csv
# Permit explicitly curated processed summaries and visualizations under 8 MB:
# (00_phase0_provenance, 02_phase1_gene_mechanism, 02_phase1_provenance,
#  03_phase2_seed_genes through 13_phase2_pathway_enrichment.html,
#  14_phase3_drug_evidence_matrix.csv through 17_phase3_repurposing_provenance.json,
#  18_phase3_query_gene_panel.csv, 18_phase3_query_panel_provenance.json,
#  19_phase3_query_panel_citations.csv,
#  20_phase4_reaction_level_matrix.csv through 24_phase4_adjudication_provenance.json)
data/processed/track2/pathway/
/data/processed/track2/pathway_david/
data/interim/pathway_cache/

# Committed reports under docs/reports/ are exempt from the local-artifact size policy.
# Raw/interim genomic data stays out of Git.

# Public reference archives and extracted tool databases remain local.
database/refs/

# Local patient input and public reference databases.
data/input/

# Publication policy (hackathon rules: no patient-derived data may be published).
# Variant-level and phenotype-level artifacts stay out of Git even if generated
# under an allowed directory.
data/processed/variant_evidence_master.csv
data/processed/rare_candidates.csv
data/processed/gene_inheritance_summary.csv
data/processed/track2/02_phase1_gene_mechanism_matrix.csv
MVA_PATIENT_PROFILE_REPORT.md
docs/MVA_PATIENT_PROFILE_REPORT.md
docs/reports/HPO.txt

# DAVID native/external artifacts are non-versioned by policy.
docs/reports/mva-david-replay-*/

# Transient subfolders inside otherwise-committed report runs.
docs/reports/*/cache/
docs/reports/*/logs/
docs/reports/*/runtime/
docs/reports/*/compass-verify*/
**/.DS_Store

